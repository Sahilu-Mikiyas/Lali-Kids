# Copy to .env.local for local development. Never commit real values.

# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Bypasses row-level security; keep it secret.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional. Signs short-lived page links. If empty, a key is derived from SUPABASE_SECRET_KEY.
PAGE_TOKEN_SECRET=
